# Copy this file to .env.local for local development and set the same
# variables in your hosting provider (for example Vercel > Settings >
# Environment Variables) BEFORE running a production build.

# REQUIRED for production builds. Your public site URL, no trailing slash.
# Used for canonical URLs, Open Graph, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. Google Analytics 4 measurement ID. When set, a cookie consent
# banner is shown and analytics only starts after the visitor accepts.
NEXT_PUBLIC_GA_ID=

# Optional. Your AdSense publisher ID (ca-pub-...). When set, the
# google-adsense-account verification meta tag is added to every page.
NEXT_PUBLIC_ADSENSE_CLIENT=
